{
  "name": "swipe-spy-app",
  "version": "1.0.0",
  "description": "Local-first desktop spy app for LinkedIn and X/Twitter monitoring",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "spy",
    "linkedin",
    "twitter",
    "monitoring"
  ],
  "author": "Thomas Kümpfel",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "chromedriver": "^120.0.0",
    "csv-parser": "^3.0.0",
    "electron-store": "^8.1.0",
    "node-notifier": "^10.0.1",
    "selenium-webdriver": "^4.16.0",
    "uuid": "^9.0.1"
  },
  "build": {
    "appId": "com.swipe.spyapp",
    "productName": "Swipe Spy",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "zip",
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
